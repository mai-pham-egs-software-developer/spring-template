# Keycloak connection settings, consumed via import.meta.env in src/auth/keycloak.js.
# This client must exist in Keycloak as a PUBLIC client with:
#  - Standard flow enabled, PKCE (S256)
#  - Valid redirect URIs: http://localhost:5173/*
#  - Web origins: http://localhost:5173
# It is intentionally separate from the backend's confidential "be-application"
# client (backend/source/applications/main/src/main/resources/application.yml),
# which uses the server-side authorization_code + client-secret flow instead.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=bootstrap
VITE_KEYCLOAK_CLIENT_ID=fe-application

# Base URL of the backend API this app calls with the Keycloak access token.
VITE_API_BASE_URL=http://localhost:8081
