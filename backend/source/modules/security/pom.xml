<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.my.craft</groupId>
    <artifactId>security</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>security</name>
    <description>Shared Spring Security config: OIDC (OAuth2 client) login + JWT resource server</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- HttpSecurity / SecurityFilterChain / CorsUtils reference jakarta.servlet.*.
             The actual servlet container comes from the consuming app's own
             spring-boot-starter-web (e.g. applications/main) at runtime. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- CasbinAuthorizationManager resolves the current request's HandlerMethod via
             RequestMappingHandlerMapping to read @RequiresPermission. Same reasoning as
             jakarta.servlet-api above: type-only at compile time, the real
             RequestMappingHandlerMapping bean comes from the consuming app's own
             spring-boot-starter-web at runtime. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Builds the Enforcer/Adapter beans: JDBC-backed policy storage (table casbin_rule) using
             this module's own Postgres DataSource, so RBAC policy can change at runtime without a
             redeploy, see docs/security.md.
             CHANGE-ME: pinned to 1.9.0, NOT the latest (2.0.0) on purpose. 2.0.0's
             CasbinAutoConfiguration is compiled against spring-boot-starter-parent 4.0.0 and
             references org.springframework.boot.jdbc.autoconfigure.DataSourceProperties /
             JdbcTemplateAutoConfiguration, packages that only exist in Boot 4 (Boot 4 moved these
             out of spring-boot-autoconfigure). Against this module's Boot 3.5.16 parent that fails
             at startup with NoClassDefFoundError. 1.9.0 targets the pre-move
             org.springframework.boot.autoconfigure.jdbc.* package and works correctly here;
             re-evaluate only if/when this project's own parent moves to Boot 4. -->
        <dependency>
            <groupId>org.casbin</groupId>
            <artifactId>casbin-spring-boot-starter</artifactId>
            <version>1.9.0</version>
        </dependency>
        <!-- Backs User/Organization/Role/Permission (com.my.craft.security.domain) unrelated to
             Casbin, see SecurityJpaConfig. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Admin REST API client for the target identity provider (Keycloak here), backs
             KeycloakUserService / the master-account bootstrap. Separate from
             spring-boot-starter-oauth2-client/-resource-server above, which only ever authenticate
             end users against Keycloak, never manage it. -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-admin-client</artifactId>
            <version>26.0.12</version>
        </dependency>
    </dependencies>
</project>
